xadreznorte.duckdns.org, torneiosdexadrez.pt {
	# Same-origin path for the GoatCounter tracking script/endpoint, so the
	# browser loads it over https:// too -- an http:// script on this https
	# page gets silently blocked as mixed content otherwise.
	@goatcounter path /count /count.js
	reverse_proxy @goatcounter goatcounter:8080

	reverse_proxy web:8000
}
