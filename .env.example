# Copy to .env and fill in real values before running docker compose.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-random-string
# Set to "true" once this is served over HTTPS (reverse proxy or platform TLS).
# Leave "false" for plain-HTTP/local testing, otherwise the browser won't send
# the admin session cookie back and login will look broken.
SESSION_HTTPS_ONLY=false

# Self-hosted GoatCounter analytics (optional, all five blank by default —
# see README for the full flow). GC_SITE_* auto-creates the GoatCounter site
# on first deploy (fresh volume) instead of requiring the manual web wizard;
# leave them blank to keep using the wizard. GOATCOUNTER_SCRIPT_URL/ENDPOINT
# control the tracking snippet rendered into the site itself and only render
# once both are set — get their values from GoatCounter's own "Site code"
# page after the site exists (NOT the same as GC_SITE_VHOST: GoatCounter's
# own dashboard there defaults to an https:// URL with no port, which only
# works once you're behind a real reverse proxy — for plain-HTTP/local
# testing use http://<vhost>:8081/count(.js) explicitly instead).
GC_SITE_VHOST=
GC_SITE_ADMIN_EMAIL=
GC_SITE_ADMIN_PASSWORD=
GOATCOUNTER_SCRIPT_URL=
GOATCOUNTER_ENDPOINT=
